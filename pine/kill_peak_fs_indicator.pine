//@version=6
// =============================================================================
//  Kill Peak + Failure Swing (indicator) — ghep hai engine da co trong repo.
//
//  Y tuong, chieu BUY (SELL soi guong): M3 chot mot muc gia dang no mot cu len
//  quet dinh da bo lai ("muc cho kill"); M1 cho dung luc phe ban kiet suc bang
//  mot setup failure swing day du roi moi bop co. TP = muc cho kill do, khong
//  phai mot boi so R co dinh.
//
//  Ba tang, chay theo thu tu trong moi nen (spec §6):
//    1. Boi canh M3   — chep tu pine/kill_peak_indicator.pine, vung
//       `KHOI BOI CANH HTF`. Cho ra killHigh/killLow + flagBuy/flagSell.
//    2. May trang thai M1 — chep tu pine/rsi_failure_swing_indicator.pine,
//       cac vung `KHOI M1-A/B/C`, tru rieng than buoc 3 (thay bang khoi noi
//       moi J-BUY/J-SELL). Bon trang thai IDLE/SEEKING/ARMED/BROKEN, phat
//       hien failure swing. Noi o Task 5.
//    3. Khoi noi — code moi cua du an nay: gate co + cua so + loc RR, dat
//       TP = muc cho kill. Noi o Task 5.
//
//  BAT BIEN CHEP NGUYEN VAN: moi vung co moc `// ---- KHOI <ten> ----` /
//  `// ---- HET KHOI <ten> ----` phai giong het ban goc theo tung dong. Chong
//  troi phien ban bang `scratchpad/blockdiff.py` (chay tu goc repo), KHONG
//  bang tri nho — sua luat thi sua o file goc roi chep lai qua day.
//
//  CHUA COMPILE DUOC O MAY NAY. Moi thu chi qua checker tinh (kp_check.py),
//  oracle Python va doc tay. Khong duoc viet "da test"/"da verify"/"chay
//  duoc" o bat cu dau lien quan file nay.
//
//  Rui ro da biet quan trong nhat (spec §11.1): diem vao (RSI M1 cat len 50
//  LAN THU HAI) muon hon han diem vao cua kill_peak goc (RSI(2) het leg), nen
//  RR co the kem mot cach he thong — TP (killHigh - entry) ngan di trong khi
//  SL van treo o day chan 2. Doc dong "Loai vi RR" o bang dem TRUOC TIEN de do
//  rui ro nay truoc khi ket luan gi ve setup.
// =============================================================================
indicator("Kill Peak FS", overlay=true, max_lines_count=500, max_labels_count=500)

grpCtx = "Boi canh (HTF)"
htfTf  = input.timeframe("3", "Khung boi canh", group=grpCtx)
ctxLen = input.int(14,   "RSI boi canh", minval=2, group=grpCtx)
ctxHi  = input.float(70, "Moc mo doan do", group=grpCtx)
ctxMid = input.float(50, "Moc chot muc + bat co", group=grpCtx)
ctxLo  = input.float(30, "Moc huy co", group=grpCtx)

grpRsi   = "RSI (khung chart)"
rsiLen   = input.int(14, "RSI length", minval=2, group=grpRsi)
obLevel  = input.float(70, "Muc qua mua (mo pha SELL)", group=grpRsi)
midLevel = input.float(50, "Muc giua (chot chan + xac nhan)", group=grpRsi)
osLevel  = input.float(30, "Muc qua ban (mo pha BUY)", group=grpRsi)

grpCancel = "Huy setup M1"
cancelHi  = input.float(70, "Huy BUY khi RSI >=", group=grpCancel,
     tooltip="Len duoc toi day la thi truong da roi che do do day — tien de cua setup mat.")
cancelLo  = input.float(30, "Huy SELL khi RSI <=", group=grpCancel)
maxWait   = input.int(150, "Het han sau (nen, 0 = tat)", minval=0, group=grpCancel,
     tooltip="Dem tu luc ARM, tuc luc RSI cat qua muc giua lan dau.")

requireR2Beyond = input.bool(false, "Bat buoc chan 2 nam trong nguong duoi day", group=grpCancel,
     tooltip="TAT (mac dinh): nguong duy nhat la RSI cua chan 1 — chan 2 duoc phep xuong duoi 30 mien la con cao hon chan 1. BAT: them dieu kien chan 2 phai nam trong r2Lo/r2Hi.")
r2Lo = input.float(30, "  nguong chan 2 phia duoi (BUY)", group=grpCancel)
r2Hi = input.float(70, "  nguong chan 2 phia tren (SELL)", group=grpCancel)

grpWindow = "Cua so cho kill"
requireLeg2AfterFlag = input.bool(true, "Chan 2 phai nam sau khi bat co", group=grpWindow,
     tooltip="Nen day cua chan 2 phai o sau nen bat co. Neu chan 2 hinh thanh truoc khi muc cho kill ton tai thi phan ky do dang noi ve mot con song khac.")
oneTradePerFlag = input.bool(true, "Mot co toi da mot lenh", group=grpWindow)

grpRisk    = "Rui ro"
atrLen     = input.int(14,   "ATR length", minval=1, group=grpRisk)
slAtrMult  = input.float(0.5, "SL bien (x ATR)", minval=0, step=0.1, group=grpRisk)
minRR      = input.float(1.0, "RR toi thieu", minval=0, step=0.5, group=grpRisk)
maxRR      = input.float(0.0, "RR toi da (0 = khong chan)", minval=0, step=1.0, group=grpRisk)
minSlTicks = input.int(10, "SL toi thieu (tick)", minval=0, group=grpRisk)

grpEntry   = "Chieu"
enableBuy  = input.bool(true, "Enable BUY", group=grpEntry)
enableSell = input.bool(true, "Enable SELL", group=grpEntry)

grpShow      = "Hien thi"
showCtx      = input.bool(true, "Doan do + muc cho kill", group=grpShow)
showState    = input.bool(true, "To nen theo trang thai M1", group=grpShow)
showDiv      = input.bool(true, "Duong phan ky chan 1 -> chan 2", group=grpShow)
showSig      = input.bool(true, "Mui ten + nhan entry + SL/TP", group=grpShow)
showRejected = input.bool(true, "Nhan setup bi loai vi RR", group=grpShow)
showTable    = input.bool(true, "Bang trang thai", group=grpShow)
showCounters = input.bool(true, "Bang dem", group=grpShow)

float ctxRsi = request.security(syminfo.tickerid, htfTf, ta.rsi(close, ctxLen)[1],
     barmerge.gaps_off, barmerge.lookahead_on)

float tfRatio = timeframe.in_seconds(htfTf) * 1.0 / timeframe.in_seconds()
int   n       = math.max(1, int(math.ceil(tfRatio)))

// ta.* phai goi o top level, khong duoc nam trong if — chung giu state noi bo
float seedHigh = ta.highest(high, n)
float seedLow  = ta.lowest(low, n)

if barstate.isfirst and timeframe.in_seconds(htfTf) <= timeframe.in_seconds()
    runtime.error("Khung boi canh phai lon hon khung chart")

// ---- KHOI BOI CANH HTF ----
var bool   measHi      = false
var float  runHigh     = na
var float  killHigh    = na
var int    killHighBar = na
var bool   flagBuy     = false
var int    flagBuyBar  = na
var bool   flagBuyUsed = false

var bool   measLo       = false
var float  runLow       = na
var float  killLow      = na
var int    killLowBar   = na
var bool   flagSell     = false
var int    flagSellBar  = na
var bool   flagSellUsed = false

string buyEnd  = na          // chi khac na dung o nen co tat
string sellEnd = na

bool ctxOk = not na(ctxRsi) and not na(ctxRsi[1])
bool cUp70 = ctxOk and ctxRsi[1] <= ctxHi  and ctxRsi > ctxHi
bool cDn50 = ctxOk and ctxRsi[1] >= ctxMid and ctxRsi < ctxMid
bool cUp50 = ctxOk and ctxRsi[1] <= ctxMid and ctxRsi > ctxMid
bool cDn30 = ctxOk and ctxRsi[1] >= ctxLo  and ctxRsi < ctxLo

// 1. noi cuc tri
if measHi
    runHigh := math.max(runHigh, high)
if measLo
    runLow := math.min(runLow, low)

// 2. cham muc
if flagBuy and high >= killHigh
    flagBuy := false
    buyEnd  := "KILL"
if flagSell and low <= killLow
    flagSell := false
    sellEnd  := "KILL"

// 3. cDn50 -> chot dinh cho kill
if cDn50 and measHi
    killHigh    := runHigh
    killHighBar := bar_index
    measHi      := false
    flagBuy     := true
    flagBuyBar  := bar_index
    flagBuyUsed := false

// 4. cUp50 -> chot day cho kill
if cUp50 and measLo
    killLow     := runLow
    killLowBar  := bar_index
    measLo      := false
    flagSell    := true
    flagSellBar := bar_index
    flagSellUsed := false

// 5. cDn30
if cDn30
    if flagBuy
        flagBuy := false
        buyEnd  := "RSIOUT"
    if flagSell
        flagSell := false
        sellEnd  := "NEWLEVEL"
    if not measLo
        measLo := true
        runLow := seedLow

// 6. cUp70
if cUp70
    if flagSell
        flagSell := false
        sellEnd  := "RSIOUT"
    if flagBuy
        flagBuy := false
        buyEnd  := "NEWLEVEL"
    if not measHi
        measHi  := true
        runHigh := seedHigh
// ---- HET KHOI BOI CANH HTF ----

// Bon bien nay KHONG co trong rsi_failure_swing (da kiem: 0 lan xuat hien).
// Chung phuc vu bo loc RR, von la thu moi cua script nay. Dat chung trong
// vung chep la pha bat bien chep nguyen van ngay tu dong dau.
float bRr    = na
bool  bRejRr = false
float sRr    = na
bool  sRejRr = false

// ---- KHOI M1-A ----
// ---------------------------------------------------------------- series
// ta.* phai o top level: chung giu state noi bo, goi trong if la sai am tham
float rsi = ta.rsi(close, rsiLen)
float atr = ta.atr(atrLen)

bool ok     = not na(rsi) and not na(rsi[1]) and not na(atr)
bool xDnOs  = ok and rsi[1] >= osLevel  and rsi < osLevel
bool xUpOb  = ok and rsi[1] <= obLevel  and rsi > obLevel
bool xUpMid = ok and rsi[1] <= midLevel and rsi > midLevel
bool xDnMid = ok and rsi[1] >= midLevel and rsi < midLevel
bool deepLo = ok and rsi <= cancelLo
bool deepHi = ok and rsi >= cancelHi

// trang thai: 0 IDLE, 1 SEEKING, 2 ARMED, 3 BROKEN
var int   bSt     = 0
var float bP1     = na
var float bR1     = na
var int   bP1Bar  = na
var int   bArmBar = na
var float bP2     = na
var int   bP2Bar  = na
var float bR2     = na
var int   bR2Bar  = na

var int   sSt     = 0
var float sP1     = na
var float sR1     = na
var int   sP1Bar  = na
var int   sArmBar = na
var float sP2     = na
var int   sP2Bar  = na
var float sR2     = na
var int   sR2Bar  = na

// chi khac na dung o nen setup chet / ra tin hieu
string bEnd   = na
string sEnd   = na
bool   bSig   = false
bool   sSig   = false
float  bEntry = na
float  bSl    = na
float  bTp    = na
float  sEntry = na
float  sSl    = na
float  sTp    = na

// 1. noi cuc tri
if bSt == 1
    if na(bP1) or low < bP1
        bP1    := low
        bP1Bar := bar_index
    if na(bR1) or rsi < bR1
        bR1 := rsi
if bSt == 2 or bSt == 3
    if na(bP2) or low < bP2
        bP2    := low
        bP2Bar := bar_index
    if na(bR2) or rsi < bR2
        bR2    := rsi
        bR2Bar := bar_index

// 2. huy cung — ap cho ca ARMED lan BROKEN
if bSt == 2 or bSt == 3
    if deepHi
        bSt  := 0
        bEnd := "HUY: RSI >= " + str.tostring(cancelHi, "#.##")
    else if maxWait > 0 and bar_index - bArmBar > maxWait
        bSt  := 0
        bEnd := "HUY: het han"

// 2b. vo hieu — CHI o BROKEN. Chan 2 thanh chan 1 moi, khong vut setup di.
if bSt == 3
    bool bBad = not na(bR2) and not na(bR1) and bR2 < bR1
    if requireR2Beyond and not bBad
        bBad := not na(bR2) and bR2 <= r2Lo
    if bBad
        bSt    := 1
        bP1    := bP2
        bP1Bar := bP2Bar
        bR1    := bR2
        bP2    := na
        bP2Bar := na
        bR2    := na
        bR2Bar := na
        bEnd   := "VO HIEU: chan 2 pha RSI chan 1"
// ---- HET KHOI M1-A ----

// 3. tin hieu — PHAI dung truoc buoc 4, xem header.
//    Day la KHOI NOI: thay cho than buoc 3 cua rsi_failure_swing. TP khong
//    con la boi so R ma la killHigh, va co them gate co + cua so + loc RR.
//    Vi tri cua no truoc buoc 4 la load-bearing: mot nen vua thung bP1 vua
//    dong cua tren 50 chi dat BROKEN, khong ra tin hieu.
if bSt == 3 and xUpMid
    bool gate = enableBuy and flagBuy and not na(killHigh)
         and (not requireLeg2AfterFlag or bP2Bar >= flagBuyBar)
         and not (oneTradePerFlag and flagBuyUsed)
    if gate
        float e = close
        float s = bP2 - slAtrMult * atr
        bool  slOk = not (minSlTicks > 0 and e - s < minSlTicks * syminfo.mintick)
        if e - s > 0 and slOk and killHigh - e > 0
            float r = (killHigh - e) / (e - s)
            if r >= minRR and (maxRR <= 0 or r <= maxRR)
                bSig        := true
                bEntry      := e
                bSl         := s
                bTp         := killHigh
                bRr         := r
                flagBuyUsed := true
            else
                bRejRr := true
                bRr    := r
    bSt := 0

// ---- KHOI M1-B ----
// 4. gia pha chan 1
if bSt == 2 and low < bP1
    bSt := 3

// 5. mo pha qua ban
if bSt == 0 and xDnOs
    bSt    := 1
    bP1    := low
    bP1Bar := bar_index
    bR1    := rsi

// 6. chot chan 1, vu trang
if bSt == 1 and xUpMid
    bSt     := 2
    bArmBar := bar_index
    bP2     := low
    bP2Bar  := bar_index
    bR2     := rsi
    bR2Bar  := bar_index

if sSt == 1
    if na(sP1) or high > sP1
        sP1    := high
        sP1Bar := bar_index
    if na(sR1) or rsi > sR1
        sR1 := rsi
if sSt == 2 or sSt == 3
    if na(sP2) or high > sP2
        sP2    := high
        sP2Bar := bar_index
    if na(sR2) or rsi > sR2
        sR2    := rsi
        sR2Bar := bar_index

if sSt == 2 or sSt == 3
    if deepLo
        sSt  := 0
        sEnd := "HUY: RSI <= " + str.tostring(cancelLo, "#.##")
    else if maxWait > 0 and bar_index - sArmBar > maxWait
        sSt  := 0
        sEnd := "HUY: het han"

if sSt == 3
    bool sBad = not na(sR2) and not na(sR1) and sR2 > sR1
    if requireR2Beyond and not sBad
        sBad := not na(sR2) and sR2 >= r2Hi
    if sBad
        sSt    := 1
        sP1    := sP2
        sP1Bar := sP2Bar
        sR1    := sR2
        sP2    := na
        sP2Bar := na
        sR2    := na
        sR2Bar := na
        sEnd   := "VO HIEU: chan 2 pha RSI chan 1"
// ---- HET KHOI M1-B ----

// 3. tin hieu chieu SELL — guong hoan toan cua J-BUY o tren.
if sSt == 3 and xDnMid
    bool gate = enableSell and flagSell and not na(killLow)
         and (not requireLeg2AfterFlag or sP2Bar >= flagSellBar)
         and not (oneTradePerFlag and flagSellUsed)
    if gate
        float e = close
        float s = sP2 + slAtrMult * atr
        bool  slOk = not (minSlTicks > 0 and s - e < minSlTicks * syminfo.mintick)
        if s - e > 0 and slOk and e - killLow > 0
            float r = (e - killLow) / (s - e)
            if r >= minRR and (maxRR <= 0 or r <= maxRR)
                sSig         := true
                sEntry       := e
                sSl          := s
                sTp          := killLow
                sRr          := r
                flagSellUsed := true
            else
                sRejRr := true
                sRr    := r
    sSt := 0

// ---- KHOI M1-C ----
if sSt == 2 and high > sP1
    sSt := 3

if sSt == 0 and xUpOb
    sSt    := 1
    sP1    := high
    sP1Bar := bar_index
    sR1    := rsi

if sSt == 1 and xDnMid
    sSt     := 2
    sArmBar := bar_index
    sP2     := high
    sP2Bar  := bar_index
    sR2     := rsi
    sR2Bar  := bar_index
// ---- HET KHOI M1-C ----

// =============================================================================
//  Ve (spec §7). Bat bien: moi predicate ve phai giong het predicate ra tin
//  hieu — khong duoc tinh lai bat cu dieu kien nao. Xem canh bao dau file va
//  Step 9 cua task-6-report.md cho phep doi chieu tung lenh ve.
// =============================================================================

// 1. duong muc cho kill, keo dai trong luc co bat
var line bLvlLn = na
var line sLvlLn = na

if showCtx and flagBuy and not flagBuy[1]
    bLvlLn := line.new(bar_index, killHigh, bar_index + 1, killHigh,
         color=color.new(color.teal, 20), width=1, style=line.style_dashed)
if showCtx and not na(bLvlLn) and flagBuy
    line.set_x2(bLvlLn, bar_index)

if showCtx and flagSell and not flagSell[1]
    sLvlLn := line.new(bar_index, killLow, bar_index + 1, killLow,
         color=color.new(color.red, 20), width=1, style=line.style_dashed)
if showCtx and not na(sLvlLn) and flagSell
    line.set_x2(sLvlLn, bar_index)

// 2. to nen theo trang thai M1
color stateCol = bSt == 1 or sSt == 1 ? color.new(color.gray, 92) :
     bSt == 2 ? color.new(color.teal, 90) :
     bSt == 3 ? color.new(color.teal, 80) :
     sSt == 2 ? color.new(color.red, 90) :
     sSt == 3 ? color.new(color.red, 80) :
     na
bgcolor(showState ? stateCol : na, title="Trang thai M1")

// 3. duong phan ky chan 1 -> chan 2 (chi ben gia, tai nen tin hieu)
if showDiv and bSig and not na(bP1Bar) and not na(bP2Bar)
    line.new(bP1Bar, bP1, bP2Bar, bP2, color=color.new(color.teal, 0), width=2)
if showDiv and sSig and not na(sP1Bar) and not na(sP2Bar)
    line.new(sP1Bar, sP1, sP2Bar, sP2, color=color.new(color.red, 0), width=2)

// 4. mui ten + nhan entry + duong SL/TP
plotshape(showSig and bSig, title="BUY", style=shape.triangleup, location=location.belowbar,
     color=color.new(color.teal, 0), size=size.small)
plotshape(showSig and sSig, title="SELL", style=shape.triangledown, location=location.abovebar,
     color=color.new(color.red, 0), size=size.small)

if showSig and bSig
    label.new(bar_index, bEntry, "BUY " + str.tostring(bEntry, format.mintick) +
         "  R " + str.tostring(bRr, "#.##"), style=label.style_label_up,
         color=color.new(color.teal, 20), textcolor=color.white, size=size.small)
    line.new(bar_index, bSl, bar_index + 20, bSl,
         color=color.new(color.red, 0), width=1, style=line.style_dashed)
    line.new(bar_index, bTp, bar_index + 20, bTp,
         color=color.new(color.teal, 0), width=1, style=line.style_dashed)
if showSig and sSig
    label.new(bar_index, sEntry, "SELL " + str.tostring(sEntry, format.mintick) +
         "  R " + str.tostring(sRr, "#.##"), style=label.style_label_down,
         color=color.new(color.red, 20), textcolor=color.white, size=size.small)
    line.new(bar_index, sSl, bar_index + 20, sSl,
         color=color.new(color.red, 0), width=1, style=line.style_dashed)
    line.new(bar_index, sTp, bar_index + 20, sTp,
         color=color.new(color.teal, 0), width=1, style=line.style_dashed)

// 5. nhan setup bi loai vi RR, va nhan ly do co chet
if showRejected and bRejRr
    label.new(bar_index, low, "LOAI RR " + str.tostring(bRr, "#.##"),
         style=label.style_label_up, color=color.new(color.gray, 70),
         textcolor=color.gray, size=size.tiny)
if showRejected and sRejRr
    label.new(bar_index, high, "LOAI RR " + str.tostring(sRr, "#.##"),
         style=label.style_label_down, color=color.new(color.gray, 70),
         textcolor=color.gray, size=size.tiny)

if showCtx and not na(buyEnd)
    label.new(bar_index, high, buyEnd, style=label.style_label_down,
         color=color.new(color.gray, 75), textcolor=color.gray, size=size.tiny)
if showCtx and not na(sellEnd)
    label.new(bar_index, low, sellEnd, style=label.style_label_up,
         color=color.new(color.gray, 75), textcolor=color.gray, size=size.tiny)

// =============================================================================
//  Bang trang thai (spec §8.1)
// =============================================================================
f_stName(s) =>
    s == 1 ? "CHO HOI" : s == 2 ? "SAN SANG" : s == 3 ? "DA PHA CHAN 1" : "—"

var table tbl = na
if showTable and barstate.islast
    if na(tbl)
        tbl := table.new(position.top_right, 2, 8, border_width=1)
    table.cell(tbl, 0, 0, "RSI M3", text_size=size.small)
    table.cell(tbl, 1, 0, na(ctxRsi) ? "—" : str.tostring(ctxRsi, "#.##"), text_size=size.small)
    table.cell(tbl, 0, 1, "Co", text_size=size.small)
    table.cell(tbl, 1, 1, flagBuy ? "CHO KILL BUY @ " + str.tostring(killHigh, format.mintick) :
         flagSell ? "CHO KILL SELL @ " + str.tostring(killLow, format.mintick) :
         "—", text_size=size.small)
    table.cell(tbl, 0, 2, "Cho (nen)", text_size=size.small)
    table.cell(tbl, 1, 2, flagBuy ? str.tostring(bar_index - flagBuyBar) :
         flagSell ? str.tostring(bar_index - flagSellBar) :
         "—", text_size=size.small)
    table.cell(tbl, 0, 3, "M1 BUY", text_size=size.small)
    table.cell(tbl, 1, 3, f_stName(bSt), text_size=size.small)
    table.cell(tbl, 0, 4, "  chan 1 (gia / RSI)", text_size=size.small)
    table.cell(tbl, 1, 4, na(bP1) ? "—" : str.tostring(bP1, format.mintick) + " / " + str.tostring(bR1, "#.#"), text_size=size.small)
    table.cell(tbl, 0, 5, "  chan 2 (gia / RSI)", text_size=size.small)
    table.cell(tbl, 1, 5, na(bP2) ? "—" : str.tostring(bP2, format.mintick) + " / " + str.tostring(bR2, "#.#"), text_size=size.small)
    table.cell(tbl, 0, 6, "M1 SELL", text_size=size.small)
    table.cell(tbl, 1, 6, f_stName(sSt), text_size=size.small)

    float liveRr = flagBuy and not na(bP2) and not na(atr) ?
         (killHigh - close) / (close - (bP2 - slAtrMult * atr)) :
         flagSell and not na(sP2) and not na(atr) ?
         (close - killLow) / ((sP2 + slAtrMult * atr) - close) :
         na
    table.cell(tbl, 0, 7, "RR neu vao bay gio", text_size=size.small)
    table.cell(tbl, 1, 7, na(liveRr) or liveRr <= 0 ? "—" : str.tostring(liveRr, "#.##"), text_size=size.small)

// =============================================================================
//  Bang dem (spec §8.2) — nam bo dem, KHONG lam cntSetup/cntRejSl (xem brief
//  Step 7: hai cai do can bien phu trong khoi noi, khoi noi khong duoc dong).
// =============================================================================
var int cntFlag   = 0
var int cntKill   = 0
var int cntCtxOut = 0
var int cntRejRr  = 0
var int cntEntry  = 0

if (flagBuy and not flagBuy[1]) or (flagSell and not flagSell[1])
    cntFlag += 1
if buyEnd == "KILL" or sellEnd == "KILL"
    cntKill += 1
if (not na(buyEnd) and buyEnd != "KILL") or (not na(sellEnd) and sellEnd != "KILL")
    cntCtxOut += 1
if bRejRr or sRejRr
    cntRejRr += 1
if bSig or sSig
    cntEntry += 1

var table cntTbl = na
if showCounters and barstate.islast
    if na(cntTbl)
        cntTbl := table.new(position.bottom_right, 2, 5, border_width=1)
    table.cell(cntTbl, 0, 0, "Co bat", text_size=size.small)
    table.cell(cntTbl, 1, 0, str.tostring(cntFlag), text_size=size.small)
    table.cell(cntTbl, 0, 1, "Co chet: KILL", text_size=size.small)
    table.cell(cntTbl, 1, 1, str.tostring(cntKill), text_size=size.small)
    table.cell(cntTbl, 0, 2, "Co chet: RSIOUT/NEWLEVEL", text_size=size.small)
    table.cell(cntTbl, 1, 2, str.tostring(cntCtxOut), text_size=size.small)
    table.cell(cntTbl, 0, 3, "Loai vi RR", text_size=size.small)
    table.cell(cntTbl, 1, 3, str.tostring(cntRejRr), text_size=size.small)
    table.cell(cntTbl, 0, 4, "Vao lenh", text_size=size.small)
    table.cell(cntTbl, 1, 4, str.tostring(cntEntry), text_size=size.small)
