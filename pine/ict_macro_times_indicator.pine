//@version=6
// =============================================================================
//  ICT Time Map — killzone + macro + Midnight Open (khong tin hieu, khong lenh)
//
//  KILLZONE (to nhat, moi vung mot mau). Gio New York:
//    Asian   20:00-00:00   (tat mac dinh)
//    London  02:00-05:00
//    NY AM   08:30-11:00   ban cho chi so (ES/NQ); forex hay dung 07:00-10:00
//    NY PM   13:30-16:00   (tat mac dinh)
//
//  MACRO (to dam, ve SAU killzone nen noi len tren). Gio New York:
//    1 London 1   02:33-03:00      5 NY AM 3    10:50-11:10
//    2 London 2   04:03-04:30      6 NY Lunch   11:50-12:10
//    3 NY AM 1    08:50-09:10      7 NY PM      13:10-13:40
//    4 NY AM 2    09:50-10:10      8 Last Hour  15:15-15:45
//  Mac dinh chi bat 3-5 (NY AM) — ba macro quan trong nhat voi ES/NQ.
//
//  MIDNIGHT OPEN: gia open cua nen dau tien sau 00:00 gio NY, ke ngang toi khi
//  sang ngay NY moi. Ngay mo phien Chu nhat (ES/NQ mo 18:00 NY) KHONG co nen
//  00:00 nen de trong — khong mang muc cua thu Sau sang, cung khong lay open
//  18:00 gia lam midnight. Nen reset ve na de plot ngat net giua hai ngay,
//  khong co doan noi doc.
//
//  MUC THANH KHOAN (plot chi co net lien -> phan biet bang mau):
//    PDH/PDL          dinh/day ngay giao dich truoc (ES/NQ: 18:00-17:00 NY)
//    Asia/London H/L  dinh/day phien, cung gio voi killzone. CHI ke sau khi
//                     phien dong; giu toi khi phien cung loai lan sau mo.
//  Moi muc co mot nhan o nen cuoi (toi da 6 label, xoa-tao lai, khong tran).
//
//  MUI GIO: moi session khai bao theo "America/New_York" nen DST tu xu ly.
//  Chart de UTC+7 van dung cho: mua he (EDT) VN = NY +11h, mua dong (EST)
//  VN = NY +12h — khong phai sua tay khi doi mua.
//
//  time() xet GIO MO cua nen: nen nao MO trong khung thi duoc to. Session ket
//  thuc la mut mo (09:10 khong tinh). He qua tren khung lon hon M1: macro bat
//  dau le phut (02:33, 04:03) se to tu nen dau tien mo sau moc do — vd M5 to
//  tu 02:35.
//
//  HAI NGUONG KHUNG: macro chi co nghia o khung nho (mac dinh <= 15 phut);
//  killzone, Midnight Open va cac muc gia van doc duoc tren H1 (mac dinh <= 60 phut).
//
//  Ve bang bgcolor/plot — khong line.new; label chi 6 cai o nen cuoi; box
//  phien 2 cai/ngay (max 500, qua do box cu nhat tu mat).
// =============================================================================
indicator("ICT Time Map", shorttitle = "ICT Time", overlay = true, max_boxes_count = 500)

const string TZ = "America/New_York"

grpK = "Killzone (gio New York)"
kAsia = input.bool(false, "Asian   20:00-00:00", inline = "ka", group = grpK)
cAsia = input.color(color.new(color.gray, 92),   "", inline = "ka", group = grpK)
kLon  = input.bool(true,  "London  02:00-05:00", inline = "kl", group = grpK)
cLon  = input.color(color.new(color.blue, 92),   "", inline = "kl", group = grpK)
kNyAm = input.bool(true,  "NY AM   08:30-11:00", inline = "kn", group = grpK)
cNyAm = input.color(color.new(color.orange, 92), "", inline = "kn", group = grpK)
kNyPm = input.bool(false, "NY PM   13:30-16:00", inline = "kp", group = grpK)
cNyPm = input.color(color.new(color.teal, 92),   "", inline = "kp", group = grpK)

grpM = "Macro (gio New York)"
m1 = input.bool(false, "1 London 1   02:33-03:00", group = grpM)
m2 = input.bool(false, "2 London 2   04:03-04:30", group = grpM)
m3 = input.bool(true,  "3 NY AM 1    08:50-09:10", group = grpM)
m4 = input.bool(true,  "4 NY AM 2    09:50-10:10", group = grpM)
m5 = input.bool(true,  "5 NY AM 3    10:50-11:10", group = grpM)
m6 = input.bool(false, "6 NY Lunch   11:50-12:10", group = grpM)
m7 = input.bool(false, "7 NY PM      13:10-13:40", group = grpM)
m8 = input.bool(false, "8 Last Hour  15:15-15:45", group = grpM)
cMacro = input.color(color.new(color.purple, 80), "Mau nen macro", group = grpM)

grpO = "Midnight Open"
showMO  = input.bool(true, "Hien Midnight Open", group = grpO)
cMO     = input.color(color.new(color.gray, 0), "Mau", group = grpO)
wMO     = input.int(1, "Do day", minval = 1, maxval = 4, group = grpO)

grpL = "Muc thanh khoan"
showPD  = input.bool(true, "PDH / PDL",         inline = "pd", group = grpL)
cPD     = input.color(color.new(color.red, 0),  "", inline = "pd", group = grpL)
showAs  = input.bool(true, "Asia High / Low",   inline = "as", group = grpL)
cAs     = input.color(color.new(color.gray, 0), "", inline = "as", group = grpL)
showLo  = input.bool(true, "London High / Low", inline = "lo", group = grpL)
cLo     = input.color(color.new(color.blue, 0), "", inline = "lo", group = grpL)
wLvl    = input.int(1, "Do day", minval = 1, maxval = 4, group = grpL)
showTag = input.bool(true, "Nhan ten o nen cuoi", group = grpL)
boxAs   = input.bool(true, "Box phien Asia",   group = grpL)
boxLo   = input.bool(true, "Box phien London", group = grpL)

grpV = "Nguong khung thoi gian"
maxTFMacro = input.int(15, "Macro: chi hien khi khung <= (phut)", minval = 1, group = grpV)
maxTFKz    = input.int(60, "Killzone + cac muc gia: khung <= (phut)", minval = 1, group = grpV)

inSess(string sess) =>
    not na(time(timeframe.period, sess, TZ))

bool tfMacro = timeframe.isintraday and timeframe.in_seconds() <= maxTFMacro * 60
bool tfKz    = timeframe.isintraday and timeframe.in_seconds() <= maxTFKz * 60

// Goi time() o MOI nen, ngoai bieu thuc and/or: v6 danh gia and/or kieu lazy,
// dat time() ben phai `x and` se bi bo qua o mot so nen.
bool zAsia = inSess("2000-0000")
bool zLon  = inSess("0200-0500")
bool zNyAm = inSess("0830-1100")
bool zNyPm = inSess("1330-1600")

bool s1 = inSess("0233-0300")
bool s2 = inSess("0403-0430")
bool s3 = inSess("0850-0910")
bool s4 = inSess("0950-1010")
bool s5 = inSess("1050-1110")
bool s6 = inSess("1150-1210")
bool s7 = inSess("1310-1340")
bool s8 = inSess("1515-1545")

// --- killzone (ve truoc — nam duoi macro) -----------------------------------
color kzCol = kAsia and zAsia ? cAsia :
              kLon  and zLon  ? cLon  :
              kNyAm and zNyAm ? cNyAm :
              kNyPm and zNyPm ? cNyPm : na
bgcolor(tfKz ? kzCol : na, title = "Killzone")

// --- macro (ve sau — noi len tren killzone) ---------------------------------
bool inMacro = (m1 and s1) or (m2 and s2) or (m3 and s3) or (m4 and s4) or
               (m5 and s5) or (m6 and s6) or (m7 and s7) or (m8 and s8)
bgcolor(tfMacro and inMacro ? cMacro : na, title = "Macro")

// --- Midnight Open ----------------------------------------------------------
int  nyDay  = dayofmonth(time, TZ)
bool newDay = nyDay != nyDay[1]

var float mo = na
if newDay
    // Ngay moi ma nen dau khong phai gio 0 (mo phien Chu nhat 18:00) -> de trong
    mo := hour(time, TZ) == 0 ? open : na

plot(showMO and tfKz and not newDay ? mo : na, "Midnight Open", cMO, wMO,
     plot.style_linebr)

// --- PDH / PDL --------------------------------------------------------------
// high[1]/low[1] + lookahead_on: doc nen ngay DA DONG, khong repaint. "Ngay" la
// ngay giao dich cua san (ES/NQ: 18:00-17:00 NY), trung nen D cua TradingView.
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]],
     lookahead = barmerge.lookahead_on)
bool tdChange = time("D") != time("D")[1]   // nen dau ngay giao dich moi -> ngat net

bool pdOn = showPD and tfKz and not tdChange
plot(pdOn ? pdh : na, "PDH", cPD, wLvl, plot.style_linebr)
plot(pdOn ? pdl : na, "PDL", cPD, wLvl, plot.style_linebr)

// --- dinh/day phien ---------------------------------------------------------
// Trong phien: chi tich luy, KHONG ke (muc chua chot). Het phien: chot va ke,
// giu toi khi phien cung loai lan sau bat dau (luc do xoa ve na -> ngat net).
sessHL(bool inS) =>
    var float runHi = na
    var float runLo = na
    var float fixHi = na
    var float fixLo = na
    if inS and not inS[1]
        runHi := high
        runLo := low
        fixHi := na
        fixLo := na
    else if inS
        runHi := math.max(runHi, high)
        runLo := math.min(runLo, low)
    if not inS and inS[1]
        fixHi := runHi
        fixLo := runLo
    [fixHi, fixLo]

[asH, asL] = sessHL(zAsia)
[loH, loL] = sessHL(zLon)

bool asOn = showAs and tfKz
bool loOn = showLo and tfKz
plot(asOn ? asH : na, "Asia High",   cAs, wLvl, plot.style_linebr)
plot(asOn ? asL : na, "Asia Low",    cAs, wLvl, plot.style_linebr)
plot(loOn ? loH : na, "London High", cLo, wLvl, plot.style_linebr)
plot(loOn ? loL : na, "London Low",  cLo, wLvl, plot.style_linebr)

// --- box phien --------------------------------------------------------------
// Mo box o nen dau phien, gian theo high/low trong phien, dung lai khi het phien
// (box cu giu nguyen tren chart). 2 box/ngay -> max_boxes_count 500 giu ~250
// ngay; qua do box cu nhat tu bien mat — du dung cho check tay gan day.
sessBox(bool inS, bool on, color c) =>
    bool start = inS and not inS[1]   // tinh o MOI nen, ngoai khoi if
    var box b = na
    if on
        if start
            b := box.new(bar_index, high, bar_index, low, border_color = c,
                 bgcolor = color.new(c, 90))
        else if inS and not na(b)
            box.set_right(b, bar_index)
            box.set_top(b, math.max(box.get_top(b), high))
            box.set_bottom(b, math.min(box.get_bottom(b), low))
    b

sessBox(zAsia, boxAs and tfKz, cAs)
sessBox(zLon,  boxLo and tfKz, cLo)

// --- nhan o nen cuoi --------------------------------------------------------
// Moi muc MOT label, xoa-tao lai o nen cuoi -> tong cong toi da 6, khong tran.
tag(label old, float y, string txt, color c, bool on) =>
    label.delete(old)
    on and not na(y) ? label.new(bar_index, y, txt, style = label.style_label_left,
         color = color(na), textcolor = c, size = size.small) : label(na)

var label tPDH = na
var label tPDL = na
var label tAsH = na
var label tAsL = na
var label tLoH = na
var label tLoL = na
if barstate.islast
    tPDH := tag(tPDH, pdh, "PDH", cPD, showTag and pdOn)
    tPDL := tag(tPDL, pdl, "PDL", cPD, showTag and pdOn)
    tAsH := tag(tAsH, asH, "AsH", cAs, showTag and asOn)
    tAsL := tag(tAsL, asL, "AsL", cAs, showTag and asOn)
    tLoH := tag(tLoH, loH, "LoH", cLo, showTag and loOn)
    tLoL := tag(tLoL, loL, "LoL", cLo, showTag and loOn)
